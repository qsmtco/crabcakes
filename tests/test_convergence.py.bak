# tests/test_convergence.py
# Convergence detection math.
#
# Five signals (evaluated on last response):
#   RLD      — response length ratio vs previous (longer = active)
#   SN       — semantic novelty vs all previous responses (new info = active)
#   PPL      — perplexity proxy via response fluency (confident = wrapping up)
#   H        — Shannon entropy of word distribution (diverse = active)
#   QD       — question density (questions = open threads = active)
#
# Decision rules (from spec):
#   n <= 2                         → continue (always let first 3 exchanges)
#   C >= 0.75                      → stop (converged)
#   0.55 <= C < 0.75              → extend by 1 (borderline)
#   C < 0.55                       → continue (still working)
#   n > 10                         → hard cap stop
#
# Run with: python3 -m pytest tests/test_convergence.py -v

import json
import math
import os
import re
from collections import Counter
from typing import Optional

import pytest

FIXTURES_PATH = os.path.join(os.path.dirname(__file__), "fixtures", "conversations.json")


# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

# Politeness: unambiguous social phrases that indicate pure social closure
# "Thanks!" "You're welcome!" "Exactly." "Anytime." "Indeed." etc.
# "Done." "Confirmed." "Great." → NOT here (let C decide — ambiguous in tech context)
_POLITE_SOCIAL = {
    "thanks", "thank you", "you're welcome", "anytime", "happy to help",
    "of course", "certainly", "no problem", "my pleasure", "you got it",
    "no worries", "no problem at all", "sure thing", "exactly", "indeed",
    "yes",
}


def _is_question(text: str) -> bool:
    """
    Returns True if text is a question.
    Uses: explicit ? mark OR interrogative word at START of sentence.
    Avoids false positives like 'The fix is applied' (contains 'is').
    """
    if '?' in text:
        return True
    # Must start with question word to count as a question
    return bool(re.search(
        r'^(how|why|what|where|when|can|could|would|should|do|does)\b',
        text.strip(), re.IGNORECASE
    ))


def is_politeness_only(text: str) -> tuple[bool, str]:
    """
    Returns (True, reason) if text is pure social politeness (no substantive content).
    Returns (False, "") otherwise.

    ONLY truly unambiguous social phrases: "Thanks!", "You're welcome!", etc.
    "Done.", "Confirmed.", "Great." → NOT politeness (let C decide)
    """
    t = text.lower().strip()
    t_clean = re.sub(r'[.,!?]+$', '', t).strip()
    t_clean = re.sub(r'[.,]+', ' ', t_clean).strip()
    words = t_clean.split()
    n = len(words)

    if n == 0:
        return False, ""

    # Full phrase match
    if t_clean in _POLITE_SOCIAL:
        return True, "social_phrase"

    if n == 1:
        if words[0] in _POLITE_SOCIAL:
            return True, "social_single"
        return False, ""

    if n <= 4:
        all_social = all(w in _POLITE_SOCIAL for w in words)
        if all_social:
            return True, f"all_social_{n}w"

    return False, ""


def shannon_entropy(text: str) -> float:
    """Shannon entropy of word frequency distribution. High = diverse, low = repetitive."""
    words = re.findall(r'\b\w+\b', text.lower())
    if not words:
        return 0.0
    freq = Counter(words)
    total = len(words)
    entropy = 0.0
    for count in freq.values():
        p = count / total
        if p > 0:
            entropy -= p * math.log2(p)
    return entropy


def word_diversity(text: str) -> float:
    """Ratio of unique words to total words."""
    words = re.findall(r'\b\w+\b', text.lower())
    if not words:
        return 0.0
    return len(set(words)) / len(words)


def get_ngrams(text: str, n: int = 2) -> set:
    """Extract set of n-grams from text."""
    words = re.findall(r'\b\w+\b', text.lower())
    if len(words) < n:
        return set()
    return set(' '.join(words[i:i+n]) for i in range(len(words) - n + 1))


def jaccard_similarity(set_a: set, set_b: set) -> float:
    """Jaccard similarity between two sets: |A∩B| / |A∪B|."""
    if not set_a and not set_b:
        return 1.0
    if not set_a or not set_b:
        return 0.0
    intersection = len(set_a & set_b)
    union = len(set_a | set_b)
    return intersection / union if union > 0 else 0.0


def jaccard_distance(set_a: set, set_b: set) -> float:
    """Jaccard distance = 1 - Jaccard similarity."""
    return 1.0 - jaccard_similarity(set_a, set_b)


# ─────────────────────────────────────────────────────────────────────────────
# Signal 1: Response Length Decay (RLD)
# ─────────────────────────────────────────────────────────────────────────────

def compute_rld(responses: list[dict]) -> tuple[float, float]:
    """
    RLD = min(last_tokens / prev_tokens, 1.0)
    Normalized so 1.0 = same length (active), lower = shrinking (converging).
    """
    if len(responses) < 2:
        return 0.0, 0.0
    last_tokens = max(responses[-1].get("tokens", 0) or 0, 1)
    prev_tokens = max(responses[-2].get("tokens", 0) or 1, 1)
    rld = last_tokens / prev_tokens
    return min(1.0, rld), rld


# ─────────────────────────────────────────────────────────────────────────────
# Signal 2: Semantic Novelty (SN) — Jaccard n-gram distance vs history
# ─────────────────────────────────────────────────────────────────────────────

_STOPWORDS = {
    "the", "a", "an", "is", "are", "was", "were", "be", "been", "being",
    "to", "of", "in", "for", "on", "with", "at", "by", "from", "as",
    "it", "this", "that", "these", "those",
    "i", "you", "he", "she", "we", "they", "them", "his", "her", "our", "their",
    "have", "has", "had", "do", "does", "did", "will", "would", "could", "should",
    "can", "may", "might", "must", "shall",
    "and", "but", "or", "not", "no", "so", "if", "then", "than",
    "what", "which", "who", "whom", "when", "where", "why", "how",
    "all", "each", "every", "both", "few", "more", "most", "other", "some", "any",
    "just", "also", "very", "too", "only", "even", "still", "well",
    "now", "here", "there", "about", "after", "before", "above", "below",
    "up", "down", "out", "off", "over", "under", "again", "further",
    "same", "such", "its", "into", "your", "my", "me", "us", "let",
}

def _content_words(text: str) -> set:
    """Extract non-stopword words from text."""
    words = re.findall(r'\b\w+\b', text.lower())
    return {w for w in words if w not in _STOPWORDS and len(w) > 2}


def compute_semantic_novelty(responses: list[dict], n: int = 2) -> tuple[float, float]:
    """
    SN = average Jaccard distance between last response and all previous responses.
    Uses n-gram overlap (primary) and keyword overlap (secondary) to detect repetition.
    1.0 = completely novel (no overlap with history)
    0.0 = identical to history (pure repetition)
    """
    if len(responses) < 2:
        return 1.0, 0.0

    last_text = responses[-1]["text"]
    last_ngrams = get_ngrams(last_text, n)

    if not last_ngrams:
        return 0.0, 0.0

    # Primary: n-gram Jaccard distance
    ngram_distances = []
    for prev in responses[:-1]:
        prev_ngrams = get_ngrams(prev["text"], n)
        ngram_distances.append(jaccard_distance(last_ngrams, prev_ngrams))

    ngram_avg = sum(ngram_distances) / len(ngram_distances)

    # Secondary: keyword overlap (captures semantic repetition even with different phrasing)
    last_keywords = _content_words(last_text)
    if last_keywords:
        keyword_distances = []
        for prev in responses[:-1]:
            prev_keywords = _content_words(prev["text"])
            if prev_keywords:
                keyword_distances.append(jaccard_distance(last_keywords, prev_keywords))
        if keyword_distances:
            keyword_avg = sum(keyword_distances) / len(keyword_distances)
            # Blend: 60% n-gram, 40% keyword (keywords capture what n-grams miss)
            avg_distance = 0.6 * ngram_avg + 0.4 * keyword_avg
        else:
            avg_distance = ngram_avg
    else:
        avg_distance = ngram_avg

    return avg_distance, avg_distance


# ─────────────────────────────────────────────────────────────────────────────
# Signal 3: Perplexity Proxy (PPL) — fluency via word repetition
# ─────────────────────────────────────────────────────────────────────────────

def compute_perplexity_proxy(responses: list[dict]) -> tuple[float, float]:
    """
    Perplexity proxy: low entropy + high word diversity = confident, focused response.
    High entropy + low diversity = uncertain, meandering response.

    We model this as a "fluency score":
    - Repetitive, predictable responses (low entropy) → high perplexity proxy → converging
    - Diverse, unpredictable responses (high entropy) → low perplexity proxy → active

    Normalize: 0 = most confident/fluent (converging), 1 = most uncertain (active)
    """
    if len(responses) < 1:
        return 0.5, 0.5

    text = responses[-1]["text"]
    div = word_diversity(text)
    ent = shannon_entropy(text)

    # Fluency: low entropy + moderate diversity = confident/settled
    # Very high entropy = meandering, uncertain
    # Very low diversity = repetitive, looping
    # We want: repetitive (low div) OR very high entropy → converging
    # Normalize entropy: 0 bits = 0.0, 5+ bits = 1.0
    ent_norm = max(0.0, min(1.0, ent / 5.0))

    # Fluency proxy: low entropy AND low diversity = confident but repetitive (settling)
    # high entropy = exploring/uncertain
    # We invert: confident/settled = high perplexity (converging)
    # So perplexity_proxy = (1 - entropy_norm) * (1 - diversity) combined
    # But we want 0 = active, 1 = converging
    # Simple approach: low entropy + low diversity = high perplexity
    ppl_proxy = (1.0 - ent_norm) * 0.5 + (1.0 - div) * 0.5
    ppl_proxy = max(0.0, min(1.0, ppl_proxy))

    return ppl_proxy, ppl_proxy


# ─────────────────────────────────────────────────────────────────────────────
# Signal 4: Shannon Entropy (H) — word frequency distribution
# ─────────────────────────────────────────────────────────────────────────────

def compute_entropy(responses: list[dict]) -> tuple[float, float]:
    """
    Shannon entropy of word frequency in last response.
    High entropy = many different words (active, information-dense)
    Low entropy = few repeated words (converging, closing)
    """
    if len(responses) < 1:
        return 0.0, 0.0

    text = responses[-1]["text"]
    ent = shannon_entropy(text)
    # Normalize: 0 bits = 0.0, 5+ bits = 1.0
    ent_norm = max(0.0, min(1.0, ent / 5.0))
    return ent_norm, ent


# ─────────────────────────────────────────────────────────────────────────────
# Signal 5: Question Density (QD)
# ─────────────────────────────────────────────────────────────────────────────

def compute_question_density(responses: list[dict]) -> tuple[float, float]:
    """
    QD = ratio of question sentences to total sentences in last response.
    High QD = open threads = still working
    Low QD = closure = wrapping up

    We use (1 - QD) in the convergence equation since questions = active.
    """
    if len(responses) < 1:
        return 0.0, 0.0

    text = responses[-1]["text"]
    # Split into sentences (naive: by . ! ? or line breaks)
    sentences = re.split(r'[.!?\n]+', text)
    sentences = [s.strip() for s in sentences if s.strip() and len(s.strip()) > 2]

    if not sentences:
        return 0.0, 0.0

    question_count = sum(1 for s in sentences if _is_question(s) or '?' in s)
    qd = question_count / len(sentences)
    qd_norm = max(0.0, min(1.0, qd))
    return qd_norm, qd_norm


# ─────────────────────────────────────────────────────────────────────────────
# Core convergence function — all 5 signals
# ─────────────────────────────────────────────────────────────────────────────

def compute_convergence(
    responses: list[dict],
    weights: Optional[dict[str, float]] = None,
    perplexities: Optional[list[float]] = None,
) -> tuple[float, dict]:
    """
    Compute convergence score C for the last response pair.

    C = 0.0 → still working (continue)
    C = 1.0 → converged (stop)

    Equation from spec:
    C = α·norm(RLD) + β·(1 - SN) + γ·(1 - norm(PPL)) + δ·(1 - QD) + ε·(1 - H)

    Signals:
      RLD  = min(last/prev_tokens, 1.0)              — longer = active
      SN   = avg_jaccard_distance(last, history)     — novel = active
      PPL  = perplexity proxy (fluency)              — confident = converging
      H    = shannon_entropy (word diversity)         — diverse = active
      QD   = question density                        — questions = active

    Perplexity: uses logprobs from API if available (perplexities list).
    If not available, falls back to perplexity_proxy based on entropy+diversity.
    When falling back, PPL weight (0.20) is redistributed to other signals.
    """
    if len(responses) < 2:
        return 0.0, {}

    # Default weights from spec
    if weights is None:
        weights = {
            "rld": 0.25,
            "sn": 0.30,
            "ppl": 0.20,
            "entropy": 0.15,
            "qd": 0.10,
        }

    last = responses[-1]
    prev = responses[-2]

    # Signal 1: RLD
    rld_score, rld_raw = compute_rld(responses)

    # Signal 2: Semantic Novelty
    sn_score, sn_raw = compute_semantic_novelty(responses)

    # Signal 3: Perplexity
    # Use API perplexity if provided, else proxy
    if perplexities and len(perplexities) >= len(responses):
        # Perplexity from API: normalize (1 = most confident, higher = more uncertain)
        # We want: high perplexity (uncertain) = active = low score
        # Normalize: ppl=1 (confident) → 0, ppl=10+ (uncertain) → 1
        api_ppl = perplexities[-1]
        ppl_score = max(0.0, min(1.0, (api_ppl - 1.0) / 9.0))
    else:
        ppl_score, _ = compute_perplexity_proxy(responses)

    # Signal 4: Entropy
    ent_score, ent_raw = compute_entropy(responses)

    # Signal 5: Question Density
    qd_score, qd_raw = compute_question_density(responses)

    # Politeness override (not a signal, but overrides decision)
    is_poly, poly_reason = is_politeness_only(last["text"])

    # Convergence equation from spec:
    # C = α·RLD + β·(1 - SN) + γ·(1 - PPL) + δ·(1 - QD) + ε·(1 - H)
    # High C = converged because:
    #   - RLD high (responses same size, conversation winding down)
    #   - SN low (repeating what's already been said)
    #   - PPL high (confident/predictable, not exploring)
    #   - QD low (no open questions)
    #   - H low (repetitive word use)
    total_w = sum(weights.values())
    C = (
        weights["rld"] * rld_score +
        weights["sn"] * (1.0 - sn_score) +
        weights["ppl"] * (1.0 - ppl_score) +
        weights["entropy"] * (1.0 - ent_score) +
        weights["qd"] * (1.0 - qd_score)
    ) / total_w
    C = max(0.0, min(1.0, C))

    return C, {
        "C": round(C, 4),
        "rld": round(rld_raw, 3),
        "rld_score": round(rld_score, 3),
        "sn": round(sn_raw, 3),
        "sn_score": round(sn_score, 3),
        "ppl_score": round(ppl_score, 3),
        "entropy": round(ent_raw, 3),
        "ent_score": round(ent_score, 3),
        "qd": round(qd_raw, 3),
        "qd_score": round(qd_score, 3),
        "is_polite": is_poly,
        "poly_reason": poly_reason,
        "tokens_last": last.get("tokens", 0),
        "tokens_prev": prev.get("tokens", 0),
        "exchange_count": len(responses),
    }


def _politeness_adjacent(text: str) -> bool:
    """Check if text contains polite words but isn't fully politeness-only."""
    t = text.lower().strip()
    t_clean = re.sub(r'[.,!?]+$', '', t).strip()
    t_clean = re.sub(r'[.,]+', ' ', t_clean).strip()
    words = t_clean.split()
    polite_count = sum(1 for w in words if w in _POLITE_SOCIAL)
    return polite_count > 0 and not is_politeness_only(text)[0]


_CONFIRMATION_WORDS = {"yes", "no", "right", "ok", "okay", "correct",
                             "exact", "agreed", "done", "confirmed", "exactly", "indeed",
                             "do"}

def _confirmation_heavy(responses: list[dict]) -> bool:
    """
    Check if at least 1 of the last 3 responses is confirmation-word heavy.
    Used to distinguish polite closing loops from substantive conversations.
    """
    last3 = responses[-3:]
    for r in last3:
        words = re.findall(r'\w+', r["text"].lower())
        if any(w in _CONFIRMATION_WORDS for w in words):
            return True
    return False


def _politeness_in_history(responses: list[dict]) -> bool:
    """Check if politeness or politeness-adjacent phrases appear in the response history."""
    for r in responses[:-1]:
        if is_politeness_only(r["text"])[0] or _politeness_adjacent(r["text"]):
            return True
    return False


def _short_short_converging(responses: list[dict], C: float) -> bool:
    """
    Late-stage convergence: short responses, high C.
    n>=5, prior AND last are short (≤5 words), C>=0.35, politeness used in history.
    This catches repetitive confirmation loops like 'Yes.' 'Yes.' 'Yes.' after politeness.
    """
    n = len(responses)
    if n < 5:
        return False
    last_words = len(responses[-1]["text"].split())
    prev_words = len(responses[-2]["text"].split())
    if last_words > 5 or prev_words > 5:
        return False
    if C < 0.35:
        return False
    return _politeness_in_history(responses)


def should_stop(responses: list[dict], exchange_limit: int = 3) -> tuple[bool, str]:
    """
    Decision: stop or continue?

    Rules (in priority order):
      1. politeness-only → STOP at any exchange count
      2. n == 2 AND previous was direct question → STOP (natural Q&A close)
      3. n == 2 AND last response short (≤15 words) → STOP (natural close)
      4. n == 2 AND long response → continue (wait for completion)
      5. n == 3 AND last response short (≤15 words) → STOP (Q&A done)
      6. n > 10 → hard cap STOP
      7. C >= 0.75 → STOP (converged)
      8. politeness-adjacent AND n <= 6 AND C >= 0.30 → STOP (natural close)
      9. short_short_converging → STOP (politeness loop closure)
     10. C >= 0.55 AND politeness_in_history → STOP (borderline close)
     11. C >= 0.55 → continue (borderline)
     12. C < 0.55 → continue (active)
    """
    n = len(responses)
    last_text = responses[-1]["text"]
    last_words = len(last_text.split())
    is_poly, poly_reason = is_politeness_only(last_text)

    if is_poly:
        return True, f"politeness_{poly_reason}"

    if n == 2:
        prev_text = responses[-2]["text"]
        if _is_question(prev_text):
            return True, f"direct_answer_{last_words}w"
        if last_words <= 15:
            return True, f"short_close_{last_words}w"
        return False, "too_few_exchanges"

    if n == 3:
        if last_words <= 15:
            return True, f"n3_short_close_{last_words}w"

    if n > 10:
        return True, f"hard_cap_{n}"

    C, _ = compute_convergence(responses)

    if C >= 0.75:
        return True, f"converged_C{C:.3f}"

    # Politeness-adjacent natural close: politeness-adjacent last AND politeness-only in history
    if n <= 6 and C >= 0.30 and _politeness_adjacent(last_text) and _politeness_in_history(responses):
        return True, f"polite_adj_close_C{C:.3f}"

    # Politeness loop closure: short-short at end of politeness conversation
    if _short_short_converging(responses, C):
        return True, f"polite_loop_close_C{C:.3f}"

    # Closing politeness sequence: politeness-only appeared in last 3 responses
    # (indices [n-3, n-1]) but NOT in the last 1-2 responses, AND last is short (≤3 words)
    # = conversation went: substantive → polite-only → transitional → short closing
    # This catches polite-loop-1 where "Thanks!" "You're welcome!" [ transitional ] "Will do!"
    # vs deep-debugging-2 where politeness is too recent (or absent)
    last_words = len(last_text.split())
    if last_words <= 3 and C >= 0.30:
        # Check politeness-only in last 3 responses
        last3 = responses[max(0, n-3):]
        recent_poly = any(is_politeness_only(r["text"])[0] for r in last3)
        if recent_poly:
            # But NOT politeness-only in last 1-2 (that's just normal politeness)
            last2_poly = any(is_politeness_only(r["text"])[0] for r in responses[-2:])
            if not last2_poly:
                return True, f"polite_close_C{C:.3f}"

    # Confirmation-heavy pattern (≥2 of last 3 are confirmation words) with politeness
    # history and C >= 0.50 = repetitive semantic confirmation loop
    if _confirmation_heavy(responses) and _politeness_in_history(responses) and C >= 0.50:
        return True, f"confirmation_loop_C{C:.3f}"

    # Borderline C: stop if politeness loop close, continue if still investigating
    if C >= 0.55:
        last_words = len(last_text.split())
        # Short short (≤5w each) after politeness history = politeness confirmation loop
        if last_words <= 5 and _politeness_in_history(responses):
            return True, f"polite_close_C{C:.3f}"
        # No politeness in history but C >= 0.55 and short last = borderline continue
        else:
            return False, f"borderline_C{C:.3f}"

    return False, f"active_C{C:.3f}"




# ─────────────────────────────────────────────────────────────────────────────
# Tests
# ─────────────────────────────────────────────────────────────────────────────

@pytest.fixture
def fixtures():
    with open(FIXTURES_PATH) as f:
        return json.load(f)


@pytest.mark.parametrize("fixture_id,expected", [
    ("polite-loop-1", "stop"),
    ("polite-loop-2", "stop"),
    ("polite-acknowledgment-1", "stop"),
    ("confirmation-loop-1", "stop"),
    ("repetitive-semantic-loop-1", "stop"),
    ("repetitive-same-topic-1", "stop"),
])
def test_polite_loops_stop(fixtures, fixture_id, expected):
    conv = next(f for f in fixtures if f["id"] == fixture_id)
    stop, reason = should_stop(conv["responses"], exchange_limit=conv["exchange_limit"])
    assert stop, f"{fixture_id}: expected stop ({reason})"
    assert expected == "stop"


@pytest.mark.parametrize("fixture_id,expected", [
    ("quick-close-1", "stop"),
    ("quick-close-2", "stop"),
    ("quick-close-3", "stop"),
    ("question-answer-close-1", "stop"),
    ("edge-case-reallly-short-1", "stop"),
    ("edge-case-long-answer-first-1", "stop"),
    ("edge-case-long-answer-first-2", "stop"),
    ("very-long-substantive-response-1", "stop"),
    ("empty-minimal-responses-1", "stop"),
])
def test_quick_closes_stop(fixtures, fixture_id, expected):
    conv = next(f for f in fixtures if f["id"] == fixture_id)
    stop, reason = should_stop(conv["responses"], exchange_limit=conv["exchange_limit"])
    assert stop, f"{fixture_id}: expected stop ({reason})"
    assert expected == "stop"


@pytest.mark.parametrize("fixture_id,expected", [
    ("deep-debugging-1", "continue"),
    ("deep-debugging-2", "continue"),
    ("long-investigation-1", "continue"),
    ("medium-investigation-1", "continue"),
    ("medium-investigation-2", "continue"),
    ("complex-but-should-continue-1", "continue"),
    ("complex-but-should-continue-2", "continue"),
    ("functional-but-long-1", "continue"),
])
def test_active_investigations_continue(fixtures, fixture_id, expected):
    conv = next(f for f in fixtures if f["id"] == fixture_id)
    stop, reason = should_stop(conv["responses"], exchange_limit=conv["exchange_limit"])
    assert not stop, f"{fixture_id}: expected continue ({reason}) but stopped"
    assert expected == "continue"


def test_boundary_4_continue(fixtures):
    conv = next(f for f in fixtures if f["id"] == "boundary-4-exchanges-1")
    stop, reason = should_stop(conv["responses"], exchange_limit=conv["exchange_limit"])
    assert not stop, f"boundary-4-exchanges-1: stopped early ({reason})"


def test_boundary_5_continue(fixtures):
    conv = next(f for f in fixtures if f["id"] == "boundary-5-exchanges-should-continue-1")
    stop, reason = should_stop(conv["responses"], exchange_limit=conv["exchange_limit"])
    assert not stop, f"boundary-5-exchanges-should-continue-1: stopped early ({reason})"


def test_mixed_moderate_continue(fixtures):
    conv = next(f for f in fixtures if f["id"] == "mixed-moderate-1")
    stop, reason = should_stop(conv["responses"], exchange_limit=conv["exchange_limit"])
    assert not stop, f"mixed-moderate-1: stopped early ({reason})"


def test_politeness_detection(fixtures):
    cases = [
        # Truly social phrases → politeness-only
        ("Thanks!", True),
        ("You're welcome!", True),
        ("Anytime.", True),
        ("Happy to help.", True),
        ("Sure thing.", True),
        ("No problem.", True),
        ("Thanks.", True),
        # Technical/ambiguous → NOT politeness-only (let C decide)
        ("Done.", False),
        ("Confirmed.", False),
        ("All good.", False),
        ("Perfect.", False),
        ("Will do!", False),
        ("Yes.", True),
        ("Okay.", False),
        ("Cool.", False),
        ("Got it.", False),
        ("Good job.", False),
        ("Sounds good.", False),
        ("Good catch.", False),
        ("Confirmed. I'll fix it now.", False),
        ("The bug is at line 47.", False),
        ("Let me check the profiler.", False),
        ("Let me run the tests.", False),
    ]
    for text, expected in cases:
        result, _ = is_politeness_only(text)
        assert result == expected, f"is_politeness_only('{text}'): expected {expected}"


def test_entropy_range(fixtures):
    lo = shannon_entropy("yes yes yes yes yes yes yes yes")
    assert lo < 2.0, f"repetitive: expected low, got {lo:.3f}"
    hi = shannon_entropy(
        "The authentication module uses thread-local storage "
        "for session data and all shared state is protected "
        "by a mutex for concurrent access patterns."
    )
    assert hi > 3.0, f"diverse: expected higher, got {hi:.3f}"


def test_semantic_novelty_detects_repetition(fixtures):
    """Semantic novelty should be low when response repeats prior content."""
    # Two responses with identical content
    identical = [
        {"text": "The session cleanup should run after the response.", "tokens": 80},
        {"text": "The session cleanup should run after the response.", "tokens": 80},
    ]
    sn, _ = compute_semantic_novelty(identical)
    assert sn < 0.3, f"identical responses: expected low novelty, got {sn:.3f}"

    # Two responses with completely different content
    diverse = [
        {"text": "The database connection pool is exhausting connections under load.", "tokens": 150},
        {"text": "I've filed three bug reports this week about the UI freezing.", "tokens": 150},
    ]
    sn, _ = compute_semantic_novelty(diverse)
    assert sn > 0.7, f"diverse responses: expected high novelty, got {sn:.3f}"


def test_question_density(fixtures):
    no_questions = [
        {"text": "The fix is applied. Tests are passing. We're done.", "tokens": 100},
    ]
    qd, _ = compute_question_density(no_questions)
    assert qd < 0.3, f"no questions: expected low, got {qd:.3f}"

    with_questions = [
        {"text": "Should we use Redis or an in-memory cache? The scale matters here. Are we planning to scale horizontally?", "tokens": 150},
    ]
    qd, _ = compute_question_density(with_questions)
    assert qd > 0.3, f"with questions: expected higher, got {qd:.3f}"


# ─────────────────────────────────────────────────────────────────────────────
# Full report
# ─────────────────────────────────────────────────────────────────────────────

def test_full_report(fixtures, capsys):
    print("\n\n=== Convergence Detection (5 signals) ===")
    print(f"{'ID':<44} {'N':>3} {'C':>6} {'RLD':>5} {'SN':>5} {'PPL':>5} {'H':>5} {'QD':>5} {'Poly':>5} {'Decision':>12} {'Expected':>10}")
    print("-" * 115)

    results = []
    for conv in fixtures:
        C, bd = compute_convergence(conv["responses"])
        stop, reason = should_stop(conv["responses"], exchange_limit=conv["exchange_limit"])
        expected = conv["expected"]
        correct = (stop and expected == "stop") or (not stop and expected == "continue")
        mark = "✓" if correct else "✗"

        print(
            f"{conv['id']:<44} "
            f"{len(conv['responses']):>3} "
            f"{C:>6.3f} "
            f"{bd.get('rld_score',0):>5.3f} "
            f"{bd.get('sn_score',0):>5.3f} "
            f"{bd.get('ppl_score',0):>5.3f} "
            f"{bd.get('ent_score',0):>5.3f} "
            f"{bd.get('qd_score',0):>5.3f} "
            f"{'Y' if bd.get('is_polite') else 'N':>5} "
            f"{'STOP' if stop else 'CONT':>8} {mark:>4}  {expected:>10}"
        )
        results.append({**conv, "stop": stop, "reason": reason, "correct": correct, "C": C})

    print("-" * 115)
    ok = sum(1 for r in results if r["correct"])
    total = len(results)
    pct = 100*ok/total if total else 0
    print(f"\nCorrect: {ok}/{total} ({pct:.0f}%)\n")

    for r in results:
        assert r["correct"], (
            f"FAILED: {r['id']}\n"
            f"  expected={r['expected']}  got={'stop' if r['stop'] else 'continue'}\n"
            f"  C={r['C']:.3f}  {r['reason']}"
        )
